@model IEnumerable<SweetCakeShop.Models.News>
@{
    ViewData["Title"] = "Quản lý Tin tức";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">📰 Tin tức &amp; Bài viết</h4>
    <a asp-action="CreateNews" class="btn btn-pink rounded-pill px-4">
        + Tạo bài viết mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Tiêu đề</th>
                    <th>Tác giả</th>
                    <th>Ngày đăng</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var news in Model)
                {
                    <tr>
                        <td>@news.NewsId</td>
                        <td>
                            <strong>@news.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(news.Summary))
                            {
                                <br />
                                <small class="text-muted">@(news.Summary.Length > 80 ? news.Summary[..80] + "…" : news.Summary)</small>
                            }
                        </td>
                        <td>@(news.Author ?? "—")</td>
                        <td>@news.PublishedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (news.IsPublished)
                            {
                                <span class="badge bg-success rounded-pill">Đã đăng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill">Nháp</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditNews" asp-route-id="@news.NewsId"
                               class="btn btn-sm btn-outline-secondary me-1">Sửa</a>
                            <form asp-action="DeleteNews" asp-route-id="@news.NewsId"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa bài viết này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có bài viết nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
