@model SweetCakeShop.Models.News
@{
    var isEdit = Model.NewsId != 0;
    ViewData["Title"] = isEdit ? "Sửa bài viết" : "Tạo bài viết mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a asp-action="News" class="text-muted text-decoration-none">← Quay lại danh sách</a>
    <h4 class="fw-bold mt-2">@ViewData["Title"]</h4>
</div>

<div class="card border-0 shadow-sm p-4" style="max-width:760px;">
    <form asp-action="@(isEdit ? "EditNews" : "CreateNews")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input type="hidden" asp-for="NewsId" />
        }

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-semibold">Tiêu đề <span class="text-danger">*</span></label>
            <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề bài viết..." />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Author" class="form-label fw-semibold">Tác giả</label>
            <input asp-for="Author" class="form-control" placeholder="Tên tác giả..." />
        </div>

        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label fw-semibold">URL ảnh đại diện</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="https://... hoặc /images/..." />
            <small class="text-muted">Để trống nếu không có ảnh.</small>
        </div>

        <div class="mb-3">
            <label asp-for="Summary" class="form-label fw-semibold">Tóm tắt</label>
            <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Mô tả ngắn về bài viết..."></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label fw-semibold">Nội dung đầy đủ</label>
            <textarea asp-for="Content" class="form-control" rows="8" placeholder="Nội dung bài viết..."></textarea>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="PublishedAt" class="form-label fw-semibold">Ngày đăng</label>
                <input asp-for="PublishedAt" type="datetime-local" class="form-control"
                       value="@Model.PublishedAt.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPublished" class="form-check-label fw-semibold">Đăng ngay</label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-pink rounded-pill px-4">
                @(isEdit ? "💾 Lưu thay đổi" : "✅ Tạo bài viết")
            </button>
            <a asp-action="News" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
